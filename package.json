{
  "name": "pokemon-simulator-evolution",
  "version": "1.4.3",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pokesim-evolution/web --",
    "build": "npm run build -w @pokesim-evolution/web --",
    "start": "npm run build && npm start -w @pokesim-evolution/server",
    "typecheck": "npm run typecheck -w @pokesim-evolution/web && npm run typecheck -w @pokesim-evolution/server",
    "test": "npm test -w @pokesim-evolution/web && npm test -w @pokesim-evolution/server",
    "build:release": "node scripts/build-release.mjs",
    "test:launcher": "cd launcher && go test ./..."
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
