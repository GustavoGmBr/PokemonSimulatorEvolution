{
  "name": "pokemon-simulator-evolution",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pokesim-evolution/web --",
    "build": "npm run build -w @pokesim-evolution/web --",
    "typecheck": "npm run typecheck -w @pokesim-evolution/web",
    "test": "npm test -w @pokesim-evolution/web",
    "build:exe": "node scripts/build-exe.mjs",
    "test:launcher": "cd launcher && go test ./..."
  }
}
